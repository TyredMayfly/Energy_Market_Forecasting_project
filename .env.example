# ENTSO-E Transparency Platform API Key
# Get your key from: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_key_here

# Meteosource Weather API Key
# Get your key from: https://www.meteosource.com/
METEOSOURCE_API_KEY=your_meteosource_api_key_here

# Optional: Override data directory path
# DATA_DIR=./data

# Optional: Override timezone
# TIMEZONE=Europe/Amsterdam
